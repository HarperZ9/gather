{
  "mcpServers": {
    "gather": {
      "command": "python3",
      "args": [
        "-I",
        "-S",
        "-B",
        "${CLAUDE_PLUGIN_ROOT}/server/serve.py",
        "--workspace",
        "${user_config.workspace}",
        "--allow-origins-json",
        "${user_config.allowed_origins}",
        "--allow-loopback-origins-json",
        "${user_config.loopback_origins}"
      ],
      "env": {}
    }
  }
}
